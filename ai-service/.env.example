# SQLAlchemy 연결 URL. backend(Spring Boot)와 같은 DB 를 바라본다.
# docker-compose 의 PostgreSQL 이 5434 포트로 떠 있다.
DB_URL=postgresql+psycopg://tilink:tilink@localhost:5434/tilink

# FastAPI 서비스 포트. backend 는 AI_SERVICE_URL 로 이 주소를 가리킨다.
AI_SERVICE_PORT=8000

# 5단계(임베딩·TIL 생성)에서 사용한다. 지금은 값이 없어도 서비스가 뜬다.
OPENAI_API_KEY=
