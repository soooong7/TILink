# SQLAlchemy 연결 URL. backend(Spring Boot)와 같은 DB 를 바라본다.
# docker-compose 의 PostgreSQL 이 5434 포트로 떠 있다.
DB_URL=postgresql+psycopg://tilink:tilink@localhost:5434/tilink

# FastAPI 서비스 포트. backend 는 AI_SERVICE_URL 로 이 주소를 가리킨다.
AI_SERVICE_PORT=8000

# 학습자료 PDF 가 저장된 루트. backend 의 STORAGE_ROOT 와 반드시 같은 디렉터리여야 한다.
# materials.file_url 이 이 루트 기준 상대 키라서, 어긋나면 파일을 찾지 못한다.
#
# 상대 경로를 쓰면 두 서비스를 각각 어느 디렉터리에서 실행했느냐에 따라 가리키는 곳이
# 달라진다(backend 는 JVM 작업 디렉터리 기준이다). 절대 경로로 못박는 편이 안전하다.
STORAGE_ROOT=/절대/경로/tilink/uploads

# 임베딩 생성에 사용한다. 없으면 처리 요청이 FAILED 로 끝난다.
OPENAI_API_KEY=

# ---- 아래는 기본값이 있어 비워 둬도 된다 ----
# 청킹: 검색 품질 기준으로 정한 값이다. 6단계에서 검색 결과를 보고 조정한다.
# CHUNK_SIZE=600
# CHUNK_OVERLAP=100
# MIN_CHUNK_SIZE=200
# 임베딩 모델. 차원을 바꾸려면 material_chunks.embedding 마이그레이션이 필요하다.
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BATCH_SIZE=64
